<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
  <application android:label="Quest Launcher">
    <activity android:name="com.unity3d.player.UnityPlayerGameActivity"
              android:label="Quest Launcher"
              android:theme="@style/BaseUnityGameActivityTheme"
              android:screenOrientation="landscape"
              android:launchMode="singleTask"
              android:configChanges="density|fontScale|keyboard|keyboardHidden|layoutDirection|locale|mnc|mcc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
              android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
        <category android:name="com.oculus.intent.category.VR" />
      </intent-filter>
      <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
    </activity>
    <!-- Let OpenXR Meta Quest build hooks set supportedDevices automatically -->
  </application>

  <!-- Quest core -->
  <uses-feature android:name="android.hardware.vr.headtracking" android:required="true" android:version="1" />

  <!-- Hand-tracking REQUIRED bypasses Meta's "controller required" launch dialog (vr-player gotcha) -->
  <uses-feature android:name="oculus.software.handtracking" android:required="true" />
  <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />

  <!-- Launcher essentials -->
  <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
                   tools:ignore="QueryAllPackagesPermission" />

  <!-- Android 11+ package visibility — fallback for stores that strip QUERY_ALL_PACKAGES -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="com.oculus.intent.category.VR" />
    </intent>
  </queries>
</manifest>
